{
  "name": "uix-button",
  "version": "0.2.3",
  "description": "Lightweight, accessible button component for React, Vue 3, Angular and vanilla JavaScript with optional ripple effect, loading spinner, six variants and CSS-variable theming. Zero dependencies, TypeScript, tree-shakeable.",
  "license": "MIT",
  "author": "UIX Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uix-digital-official/uix-button.git"
  },
  "homepage": "https://github.com/uix-digital-official/uix-button#readme",
  "bugs": {
    "url": "https://github.com/uix-digital-official/uix-button/issues"
  },
  "keywords": [
    "button",
    "ui",
    "ui-components",
    "react",
    "vue",
    "vue3",
    "angular",
    "typescript",
    "ripple",
    "material-ripple",
    "loading-button",
    "spinner",
    "theming",
    "css-variables",
    "color-palette",
    "accessible",
    "a11y",
    "framework-agnostic",
    "design-system",
    "button-component",
    "react-button",
    "vue-button",
    "angular-button",
    "ripple-effect",
    "material-design",
    "ui-library",
    "component-library",
    "zero-dependencies",
    "tree-shakeable",
    "ssr",
    "nextjs",
    "esm",
    "cjs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
